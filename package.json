{
  "name": "soc-inno",
  "type": "module",
  "private": true,
  "version": "0.1.1",
  "scripts": {
    "start": "node --import ./.output/server/sentry.server.config.mjs .output/server/index.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:dev": "yarn db:generate && yarn db:migrate",
    "db:seed": "yarn tsx --env-file=.env ./server/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.919.0",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/ui": "4.8.2",
    "@nuxtjs/plausible": "3.0.2",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/nuxt": "^10",
    "@types/nodemailer": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.1",
    "nodemailer": "^8.0.10",
    "nuxt": "^4.4.7",
    "nuxt-auth-utils": "0.5.29",
    "nuxt-csurf": "1.6.5",
    "pinia": "^3.0.3",
    "postgres": "^3.4.7",
    "typescript": "^6.0.3",
    "vue": "^3.5.22",
    "vue-router": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.69",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^24.13.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "h3-formidable": "^1.0.0",
    "tsx": "^4.20.6"
  }
}
